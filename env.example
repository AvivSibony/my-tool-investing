DATA_PROVIDER=mock          # mock | alpaca
ALPACA_KEY_ID=              # data-API keys, server side only
ALPACA_SECRET=
DATABASE_URL=               # PostgreSQL (apply schema.postgres.sql first). If empty: SQLite file at DB_PATH
DB_PATH=./bot.db
ALLOW_REGISTRATION=true     # set false after you created your account(s)
PORT=3000
TRUST_PROXY=false           # true behind a reverse proxy (uses X-Forwarded-For for login rate limits)
